#!/bin/sh
# Ruijie / minieap control:
#   start|stop|restart|status|login|verify|render-conf|reauth|post-auth
# Credentials: /etc/ruijie/env (or RUIJIE_ENV).
#
# Defaults (stable):
#   RUIJIE_DHCP_TYPE=0  — minieap Keep-Alive only; OpenWrt owns DHCP
#   post-auth is SOFT renew (no ifdown)
#
# reauth = stop → start 802.1x → soft post-auth → online check
# Prefer service restart + post-auth for mild issues; use reauth when stuck.

set -e

ENV_FILE="${RUIJIE_ENV:-/etc/ruijie/env}"
MINIEAP_BIN="${MINIEAP_BIN:-/usr/sbin/minieap}"
CONF_FILE="${MINIEAP_CONF:-/etc/minieap.conf}"
PID_FILE="${MINIEAP_PID:-/var/run/minieap.pid}"
LOG_FILE="${MINIEAP_LOG:-/var/log/minieap.log}"
STATE_DIR=/var/run/ruijie-minieap
POST_AUTH="${RUIJIE_POST_AUTH:-/usr/bin/ruijie-post-auth.sh}"
PING_HOST="${RUIJIE_PING_HOST:-223.5.5.5}"

log() { logger -t ruijie-minieap "$*"; echo "[ruijie-minieap] $*"; }

die() { echo "[ruijie-minieap] ERROR: $*" >&2; exit 1; }

load_env() {
  [ -f "$ENV_FILE" ] || die "missing env file: $ENV_FILE (copy from /etc/ruijie/env.example)"
  # shellcheck disable=SC1090
  set -a
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  set +a

  : "${RUIJIE_USERNAME:?RUIJIE_USERNAME required in $ENV_FILE}"
  : "${RUIJIE_PASSWORD:?RUIJIE_PASSWORD required in $ENV_FILE}"
  RUIJIE_NIC="${RUIJIE_NIC:-wan}"
  RUIJIE_EAP_BCAST="${RUIJIE_EAP_BCAST:-1}"
  # 0 = keepalive only (recommended with OpenWrt udhcpc + soft post-auth)
  RUIJIE_DHCP_TYPE="${RUIJIE_DHCP_TYPE:-0}"
  RUIJIE_SERVICE="${RUIJIE_SERVICE:-internet}"
  RUIJIE_VERSION_STR="${RUIJIE_VERSION_STR:-RG-SU For Linux V1.31}"
  RUIJIE_FAKE_SERIAL="${RUIJIE_FAKE_SERIAL:-OPENWRT-001}"
  RUIJIE_HEARTBEAT="${RUIJIE_HEARTBEAT:-60}"
  RUIJIE_MODULE="${RUIJIE_MODULE:-rjv3}"
}

check_minieap() {
  [ -x "$MINIEAP_BIN" ] || die "minieap not found at $MINIEAP_BIN; run install.sh first"
}

# Render /etc/minieap.conf from env (no secrets in git)
# Note: procd service does not use this conf for -c; it is for manual runs.
render_conf() {
  load_env
  mkdir -p "$(dirname "$CONF_FILE")" "$STATE_DIR"
  cat > "$CONF_FILE" <<EOF
# Generated by ruijie-minieap-ctl from $ENV_FILE — do not commit
username=$RUIJIE_USERNAME
password=$RUIJIE_PASSWORD
nic=$RUIJIE_NIC
module=$RUIJIE_MODULE
daemonize=0
if-impl=sockraw
max-fail=0
max-retries=3
no-auto-reauth=0
wait-after-fail=15
stage-timeout=8
auth-round=1
pid-file=$PID_FILE
log-file=$LOG_FILE
heartbeat=$RUIJIE_HEARTBEAT
eap-bcast-addr=$RUIJIE_EAP_BCAST
dhcp-type=$RUIJIE_DHCP_TYPE
service=$RUIJIE_SERVICE
version-str=$RUIJIE_VERSION_STR
fake-serial=$RUIJIE_FAKE_SERIAL
max-dhcp-count=3
# dhcp-script intentionally omitted: OpenWrt soft post-auth owns renew
EOF
  chmod 600 "$CONF_FILE"
  log "wrote $CONF_FILE (nic=$RUIJIE_NIC eap-bcast=$RUIJIE_EAP_BCAST dhcp=$RUIJIE_DHCP_TYPE)"
}

run_minieap() {
  load_env
  check_minieap
  # no -c dhcp-script by default (stable)
  # shellcheck disable=SC2086
  "$MINIEAP_BIN" -k 1 \
    -u "$RUIJIE_USERNAME" \
    -p "$RUIJIE_PASSWORD" \
    -n "$RUIJIE_NIC" \
    --module "$RUIJIE_MODULE" \
    -a "$RUIJIE_EAP_BCAST" \
    -d "$RUIJIE_DHCP_TYPE" \
    -e "$RUIJIE_HEARTBEAT" \
    --version-str "$RUIJIE_VERSION_STR" \
    --service "$RUIJIE_SERVICE" \
    --fake-serial "$RUIJIE_FAKE_SERIAL" \
    -t 8 --max-retries 3 \
    "$@"
}

is_running() {
  if [ -f "$PID_FILE" ]; then
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
  fi
  pidof minieap >/dev/null 2>&1
}

wan_ip() {
  nic="${RUIJIE_NIC:-wan}"
  ip -4 -o addr show "$nic" 2>/dev/null | awk '{print $4}' | head -1
}

online_check() {
  if command -v curl >/dev/null 2>&1; then
    code=$(curl -4 -sS -m 6 -o /dev/null -w "%{http_code}" \
      "http://connect.rom.miui.com/generate_204" 2>/dev/null || echo 000)
    [ "$code" = "204" ] || [ "$code" = "200" ] && return 0
    code=$(curl -4 -sS -m 6 -o /dev/null -w "%{http_code}" \
      "https://www.baidu.com/" 2>/dev/null || echo 000)
    [ "$code" = "200" ] || [ "$code" = "301" ] || [ "$code" = "302" ] && return 0
  fi
  ping -c 1 -W 3 "$PING_HOST" >/dev/null 2>&1
}

auth_success_recent() {
  [ -f "$LOG_FILE" ] || return 1
  tail -n 40 "$LOG_FILE" 2>/dev/null | grep -q "认证成功"
}

run_post_auth() {
  if [ -x "$POST_AUTH" ]; then
    log "post-auth: run $POST_AUTH"
    "$POST_AUTH" || true
  else
    log "post-auth: inline soft renew"
    if command -v ubus >/dev/null 2>&1; then
      ubus call network.interface.wan renew 2>/dev/null || true
    fi
    for p in $(pidof udhcpc 2>/dev/null); do
      kill -USR1 "$p" 2>/dev/null || true
    done
  fi
}

do_stop() {
  check_minieap
  if [ -x "$MINIEAP_BIN" ]; then
    "$MINIEAP_BIN" -k 2>/dev/null || true
  fi
  killall minieap 2>/dev/null || true
  sleep 1
  if pidof minieap >/dev/null 2>&1; then
    killall -9 minieap 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  log "stopped"
}

do_login() {
  render_conf
  do_stop
  load_env
  log "login once on $RUIJIE_NIC (module=$RUIJIE_MODULE a=$RUIJIE_EAP_BCAST d=$RUIJIE_DHCP_TYPE)"
  run_minieap -b 0 || return 1
}

do_start() {
  # Prefer procd service when available (Keep-Alive under supervision)
  if [ -x /etc/init.d/ruijie-minieap ]; then
    /etc/init.d/ruijie-minieap start 2>/dev/null || true
    sleep 2
    if is_running; then
      log "started via procd"
      return 0
    fi
  fi
  render_conf
  if is_running; then
    log "already running"
    return 0
  fi
  mkdir -p "$(dirname "$LOG_FILE")" "$(dirname "$PID_FILE")"
  run_minieap -b 3 -w || true
  sleep 2
  if is_running; then
    log "started (pid=$(cat "$PID_FILE" 2>/dev/null || pidof minieap))"
    return 0
  fi
  if auth_success_recent; then
    log "auth success seen in log"
    return 0
  fi
  log "start may have failed; see $LOG_FILE"
  tail -n 30 "$LOG_FILE" 2>/dev/null || true
  return 1
}

do_restart() {
  if [ -x /etc/init.d/ruijie-minieap ]; then
    /etc/init.d/ruijie-minieap restart 2>/dev/null || true
    sleep 2
    return 0
  fi
  do_stop
  sleep 1
  do_start
}

# One-shot: auth + soft DHCP + online check (use sparingly; prefer restart+post-auth)
do_reauth() {
  load_env
  check_minieap
  log "======== reauth begin ========"
  log "nic=$RUIJIE_NIC d=$RUIJIE_DHCP_TYPE before_ip=$(wan_ip)"

  do_stop
  sleep 1

  # ensure wan is up without network reload
  if command -v ubus >/dev/null 2>&1; then
    ubus call network.interface.wan up 2>/dev/null || true
  fi
  ifup wan 2>/dev/null || true
  sleep 2

  mkdir -p "$(dirname "$LOG_FILE")"
  : >> "$LOG_FILE"
  marker=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)

  do_start
  sleep 2

  auth_ok=0
  i=0
  while [ "$i" -lt 20 ]; do
    if [ -f "$LOG_FILE" ] && tail -n +$((marker + 1)) "$LOG_FILE" 2>/dev/null | grep -q "认证成功"; then
      auth_ok=1
      log "802.1x auth success"
      break
    fi
    if is_running && [ "$i" -gt 8 ]; then
      # process alive with d=0 may log slowly; try soft renew anyway
      :
    fi
    i=$((i + 1))
    sleep 2
  done

  # soft post-auth always (critical for leaving 172.23 isolation)
  sleep 2
  run_post_auth
  sleep 4
  run_post_auth
  sleep 3

  if ! is_running; then
    log "minieap not running after auth; start again for keepalive"
    do_start
  fi

  i=0
  while [ "$i" -lt 8 ]; do
    if online_check; then
      log "======== reauth OK online ip=$(wan_ip) ========"
      do_status
      return 0
    fi
    if [ "$i" = "2" ] || [ "$i" = "5" ]; then
      run_post_auth
    fi
    i=$((i + 1))
    sleep 3
  done

  log "======== reauth finished; network still offline ip=$(wan_ip) ========"
  do_status
  [ "$auth_ok" = "1" ] && return 1
  return 1
}

do_status() {
  load_env 2>/dev/null || true
  echo "env_file=$ENV_FILE"
  echo "nic=${RUIJIE_NIC:-?}"
  if is_running; then
    echo "minieap=running pid=$(cat "$PID_FILE" 2>/dev/null || pidof minieap | awk '{print $1}')"
  else
    echo "minieap=stopped"
  fi
  if online_check; then
    echo "network=online"
  else
    echo "network=offline"
  fi
  ip -4 addr show "${RUIJIE_NIC:-wan}" 2>/dev/null | awk '/inet /{print "wan_ip="$2}'
  ip route 2>/dev/null | awk '/^default/{print "default="$0; exit}'
  if [ -f "$LOG_FILE" ]; then
    echo "--- log tail ---"
    tail -n 15 "$LOG_FILE" 2>/dev/null || true
  fi
}

do_verify() {
  load_env
  echo "== ruijie-minieap verify =="
  check_minieap
  echo "minieap_bin=ok"
  [ -f "$ENV_FILE" ] && echo "env=ok" || die "env missing"
  if ! is_running; then
    log "not running, starting..."
    do_start || true
    sleep 5
    run_post_auth
  fi
  i=0
  while [ "$i" -lt 10 ]; do
    if online_check; then
      echo "verify=PASS network=online"
      do_status
      return 0
    fi
    i=$((i + 1))
    sleep 3
  done
  echo "verify=FAIL network=offline"
  do_status
  return 1
}

cmd="${1:-status}"
case "$cmd" in
  start)   do_start ;;
  stop)    do_stop ;;
  restart) do_restart ;;
  status)  do_status ;;
  login)   do_login ;;
  verify|test) do_verify ;;
  render-conf|render) render_conf ;;
  reauth|re-auth|fix) do_reauth ;;
  post-auth|renew)
    load_env 2>/dev/null || true
    run_post_auth
    sleep 2
    do_status
    ;;
  *)
    echo "usage: $0 {start|stop|restart|status|login|verify|render-conf|reauth|post-auth}"
    echo ""
    echo "  reauth     802.1x + soft DHCP renew + online check"
    echo "  post-auth  soft WAN DHCP renew only (no ifdown)"
    echo "  restart    procd/service restart (milder than reauth)"
    exit 2
    ;;
esac
