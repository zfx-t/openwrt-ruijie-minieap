#!/bin/sh
# Ruijie / minieap control: start|stop|restart|status|login|verify|render-conf
# Credentials and options come from /etc/ruijie/env (or RUIJIE_ENV).

set -e

ENV_FILE="${RUIJIE_ENV:-/etc/ruijie/env}"
MINIEAP_BIN="${MINIEAP_BIN:-/usr/sbin/minieap}"
CONF_FILE="${MINIEAP_CONF:-/etc/minieap.conf}"
PID_FILE="${MINIEAP_PID:-/var/run/minieap.pid}"
LOG_FILE="${MINIEAP_LOG:-/var/log/minieap.log}"
STATE_DIR=/var/run/ruijie-minieap

log() { logger -t ruijie-minieap "$*"; echo "[ruijie-minieap] $*"; }

die() { echo "[ruijie-minieap] ERROR: $*" >&2; exit 1; }

load_env() {
  [ -f "$ENV_FILE" ] || die "missing env file: $ENV_FILE (copy from /etc/ruijie/env.example)"
  # shellcheck disable=SC1090
  set -a
  # strip CR, ignore comments/blank
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  set +a

  : "${RUIJIE_USERNAME:?RUIJIE_USERNAME required in $ENV_FILE}"
  : "${RUIJIE_PASSWORD:?RUIJIE_PASSWORD required in $ENV_FILE}"
  RUIJIE_NIC="${RUIJIE_NIC:-wan}"
  RUIJIE_EAP_BCAST="${RUIJIE_EAP_BCAST:-1}"
  RUIJIE_DHCP_TYPE="${RUIJIE_DHCP_TYPE:-2}"
  RUIJIE_SERVICE="${RUIJIE_SERVICE:-internet}"
  RUIJIE_VERSION_STR="${RUIJIE_VERSION_STR:-RG-SU For Linux V1.31}"
  RUIJIE_FAKE_SERIAL="${RUIJIE_FAKE_SERIAL:-OPENWRT-001}"
  RUIJIE_HEARTBEAT="${RUIJIE_HEARTBEAT:-60}"
  RUIJIE_MODULE="${RUIJIE_MODULE:-rjv3}"
}

check_minieap() {
  [ -x "$MINIEAP_BIN" ] || die "minieap not found at $MINIEAP_BIN; run install.sh first"
}

# Render /etc/minieap.conf from env (no secrets in git)
render_conf() {
  load_env
  mkdir -p "$(dirname "$CONF_FILE")" "$STATE_DIR"
  cat > "$CONF_FILE" <<EOF
# Generated by ruijie-minieap-ctl from $ENV_FILE — do not commit
username=$RUIJIE_USERNAME
password=$RUIJIE_PASSWORD
nic=$RUIJIE_NIC
module=$RUIJIE_MODULE
daemonize=0
if-impl=sockraw
max-fail=0
max-retries=3
no-auto-reauth=0
wait-after-fail=15
stage-timeout=8
auth-round=1
pid-file=$PID_FILE
log-file=$LOG_FILE
heartbeat=$RUIJIE_HEARTBEAT
eap-bcast-addr=$RUIJIE_EAP_BCAST
dhcp-type=$RUIJIE_DHCP_TYPE
service=$RUIJIE_SERVICE
version-str=$RUIJIE_VERSION_STR
fake-serial=$RUIJIE_FAKE_SERIAL
max-dhcp-count=3
# after auth: refresh OpenWrt WAN lease (isolated pre-auth IP -> real IP)
dhcp-script=${RUIJIE_DHCP_SCRIPT:-/usr/bin/ruijie-post-auth.sh}
EOF
  chmod 600 "$CONF_FILE"
  log "wrote $CONF_FILE (nic=$RUIJIE_NIC eap-bcast=$RUIJIE_EAP_BCAST dhcp=$RUIJIE_DHCP_TYPE)"
}

run_minieap() {
  # $1 = extra daemonize flag args end: e.g. -b 0  or  -b 3 -w
  load_env
  check_minieap
  _dhcp_script="${RUIJIE_DHCP_SCRIPT:-/usr/bin/ruijie-post-auth.sh}"
  # shellcheck disable=SC2086
  "$MINIEAP_BIN" -k 1 \
    -u "$RUIJIE_USERNAME" \
    -p "$RUIJIE_PASSWORD" \
    -n "$RUIJIE_NIC" \
    --module "$RUIJIE_MODULE" \
    -a "$RUIJIE_EAP_BCAST" \
    -d "$RUIJIE_DHCP_TYPE" \
    -e "$RUIJIE_HEARTBEAT" \
    --version-str "$RUIJIE_VERSION_STR" \
    --service "$RUIJIE_SERVICE" \
    --fake-serial "$RUIJIE_FAKE_SERIAL" \
    -c "$_dhcp_script" \
    -t 8 --max-retries 3 \
    "$@"
}

is_running() {
  if [ -f "$PID_FILE" ]; then
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
  fi
  pidof minieap >/dev/null 2>&1
}

do_stop() {
  check_minieap
  if [ -x "$MINIEAP_BIN" ]; then
    "$MINIEAP_BIN" -k 2>/dev/null || true
  fi
  killall minieap 2>/dev/null || true
  # stuck D-state may remain until reboot; best effort
  rm -f "$PID_FILE"
  log "stopped"
}

# One-shot foreground login (blocks until success or fail)
do_login() {
  render_conf
  do_stop
  load_env
  log "login once on $RUIJIE_NIC (module=$RUIJIE_MODULE a=$RUIJIE_EAP_BCAST d=$RUIJIE_DHCP_TYPE)"
  run_minieap -b 0 || return 1
}

# Background keep-alive (for init / manual)
do_start() {
  render_conf
  if is_running; then
    log "already running"
    return 0
  fi
  mkdir -p "$(dirname "$LOG_FILE")" "$(dirname "$PID_FILE")"
  # -b 3: daemonize to log file; -w save conf
  run_minieap -b 3 -w || true
  sleep 2
  if is_running; then
    log "started (pid=$(cat "$PID_FILE" 2>/dev/null || pidof minieap))"
    return 0
  fi
  # some builds write log only
  if grep -q "认证成功" "$LOG_FILE" 2>/dev/null; then
    log "auth success seen in log"
    return 0
  fi
  log "start may have failed; see $LOG_FILE"
  tail -n 30 "$LOG_FILE" 2>/dev/null || true
  return 1
}

do_restart() {
  do_stop
  sleep 1
  do_start
}

online_check() {
  # 204 = captive portal pass / online
  code=$(curl -sS -m 6 -o /dev/null -w "%{http_code}" http://connect.rom.miui.com/generate_204 2>/dev/null || echo 000)
  [ "$code" = "204" ] && return 0
  # fallback: ping
  ping -c 1 -W 3 223.5.5.5 >/dev/null 2>&1
}

do_status() {
  load_env 2>/dev/null || true
  echo "env_file=$ENV_FILE"
  echo "nic=${RUIJIE_NIC:-?}"
  if is_running; then
    echo "minieap=running pid=$(cat "$PID_FILE" 2>/dev/null || pidof minieap | awk '{print $1}')"
  else
    echo "minieap=stopped"
  fi
  if online_check; then
    echo "network=online"
  else
    echo "network=offline"
  fi
  ip -4 addr show "${RUIJIE_NIC:-wan}" 2>/dev/null | awk '/inet /{print "wan_ip="$2}'
  ip route 2>/dev/null | awk '/^default/{print "default="$0; exit}'
  if [ -f "$LOG_FILE" ]; then
    echo "--- log tail ---"
    tail -n 15 "$LOG_FILE" 2>/dev/null || true
  fi
}

do_verify() {
  load_env
  echo "== ruijie-minieap verify =="
  check_minieap
  echo "minieap_bin=ok"
  [ -f "$ENV_FILE" ] && echo "env=ok" || die "env missing"
  if ! is_running; then
    log "not running, starting..."
    do_start || true
    sleep 3
  fi
  # wait up to ~30s for online
  i=0
  while [ "$i" -lt 10 ]; do
    if online_check; then
      echo "verify=PASS network=online"
      do_status
      return 0
    fi
    i=$((i + 1))
    sleep 3
  done
  echo "verify=FAIL network=offline"
  do_status
  return 1
}

cmd="${1:-status}"
case "$cmd" in
  start)   do_start ;;
  stop)    do_stop ;;
  restart) do_restart ;;
  status)  do_status ;;
  login)   do_login ;;
  verify|test) do_verify ;;
  render-conf|render) render_conf ;;
  *)
    echo "usage: $0 {start|stop|restart|status|login|verify|render-conf}"
    exit 2
    ;;
esac
