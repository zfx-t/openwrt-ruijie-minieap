# ============================================================
# 锐捷 / minieap 认证环境配置（路由器）
# ============================================================
# 安装路径：/etc/ruijie/env
# 权限要求：chmod 600 /etc/ruijie/env（仅 root 可读）
# 修改后执行：/etc/init.d/ruijie-minieap restart
#
# 注意：
# 1. 含空格的值必须用双引号包裹
# 2. 不要把填好真实密码的文件提交到 Git
# ============================================================

# ---------- 账号（必填）----------

# 校园网账号 / 学号 / 工号
RUIJIE_USERNAME="YOUR_STUDENT_ID"

# 校园网密码
RUIJIE_PASSWORD="YOUR_PASSWORD"

# ---------- 网卡 ----------

# 面对校园网的接口名（在路由器上执行: ip -br link 或 uci show network.wan）
# 常见值：wan、eth0.2、eth1、pppoe-wan 前的物理口
# 暨南宿舍实测：必须用 wan，不要用 eth0 整口
RUIJIE_NIC="wan"

# ---------- 锐捷 / minieap 认证参数 ----------

# EAPOL Start 广播地址类型（对应 minieap -a）
#   0 = 标准以太网广播
#   1 = 锐捷私有组播（多数锐捷校园网需要此项，含暨南）
# 填 0 时常见现象：一直「正在查找认证服务器」
RUIJIE_EAP_BCAST="1"

# DHCP 时机（对应 minieap -d / dhcp-type）
#   0 = minieap 不做 DHCP，只保活 Keep-Alive（推荐，配合 OpenWrt udhcpc + post-auth 软续租）
#   1 = 二次认证（认证中途跑 DHCP 再二次认证）
#   2 = 认证成功后再由 minieap 触发 DHCP（易与 netifd 抢租约，部分构建会随后退出）
#   3 = 认证前先 DHCP
# 稳定默认：0。认证后换段（172.23 隔离 -> 172.20 正式）交给 ruijie-post-auth.sh（软 renew）
RUIJIE_DHCP_TYPE="0"

# 服务名（对应 minieap --service）
# 部分学校要求填写运营商或业务名，如 internet / 校园网
# 官方客户端 -s 列表中的名称；不确定时先试 internet
RUIJIE_SERVICE="internet"

# 客户端版本字符串（对应 minieap --version-str）
# 部分交换机/服务器会校验客户端版本，需与学校下发的 RG-SU 一致
# 暨南官方 Linux 学生版为 1.31，建议保持下面默认值
# 含空格，必须加引号
RUIJIE_VERSION_STR="RG-SU For Linux V1.31"

# 伪造硬盘序列号（对应 minieap --fake-serial）
# 锐捷私有字段可能采集磁盘序列号；OpenWrt 无真实盘符时用固定字符串即可
RUIJIE_FAKE_SERIAL="OPENWRT-001"

# 心跳间隔秒数（对应 minieap -e / heartbeat）
# 认证成功后定时发 Keep-Alive，防止会话被踢；一般 30～60
RUIJIE_HEARTBEAT="60"

# minieap 数据包插件模块名
#   rjv3 = 锐捷 V3/V4 私有算法（本仓库默认，暨南验证通过）
# 一般不要改
RUIJIE_MODULE="rjv3"

# ---------- 可选：minieap 安装包地址 ----------

# 当 opkg 没有 minieap，或包与固件 ABI 不兼容时，install.sh 会从此 URL 下载 .ipk
# 请按路由器架构（DISTRIB_ARCH）与固件年代选择，过新的包可能报 time64 符号错误
# 示例（mipsel_24kc + OpenWrt/ImmortalWrt 约 21.02）：
# MINIEAP_IPK_URL="https://downloads.immortalwrt.org/releases/21.02.7/packages/mipsel_24kc/packages/minieap_0.93-3_mipsel_24kc.ipk"
MINIEAP_IPK_URL=""
