#!/bin/sh /etc/rc.common
# OpenWrt procd service: Ruijie campus auth via minieap
# Config: /etc/ruijie/env
#
# Design (stable):
# - minieap only does 802.1x + Keep-Alive (default RUIJIE_DHCP_TYPE=0)
# - OpenWrt udhcpc owns WAN IPv4; soft post-auth renews after auth
# - no -c dhcp-script (races with udhcpc / can drop good leases)
# - no procd network reload trigger (renew must not restart minieap)

START=99
STOP=10
USE_PROCD=1

NAME=ruijie-minieap
ENV_FILE=/etc/ruijie/env
MINIEAP=/usr/sbin/minieap
POST_AUTH=/usr/bin/ruijie-post-auth.sh

_wait_wan() {
  # shellcheck disable=SC1090
  [ -f "$ENV_FILE" ] && . "$ENV_FILE" 2>/dev/null || true
  _nic="${RUIJIE_NIC:-wan}"
  _i=0
  while [ "$_i" -lt 30 ]; do
    if [ -d "/sys/class/net/$_nic" ]; then
      st=$(cat "/sys/class/net/$_nic/operstate" 2>/dev/null || echo down)
      if [ "$st" = "up" ] || ip -4 addr show "$_nic" 2>/dev/null | grep -q "inet "; then
        logger -t "$NAME" "WAN $_nic ready (waited ${_i}s)"
        return 0
      fi
    fi
    _i=$((_i + 1))
    sleep 1
  done
  logger -t "$NAME" "WAN $_nic not ready after 30s, start anyway"
  return 0
}

boot() {
  (
    sleep 8
    _wait_wan
    sleep 3
    start
    # soft renew only if still offline (no stop/start thrash)
    sleep 15
    if ! ping -c 1 -W 2 223.5.5.5 >/dev/null 2>&1; then
      logger -t "$NAME" "boot: offline, soft post-auth"
      [ -x "$POST_AUTH" ] && "$POST_AUTH"
      sleep 8
      if ! ping -c 1 -W 2 223.5.5.5 >/dev/null 2>&1; then
        logger -t "$NAME" "boot: still offline, one service restart + soft post-auth"
        stop
        sleep 2
        start
        sleep 12
        [ -x "$POST_AUTH" ] && "$POST_AUTH"
      fi
    fi
  ) &
}

start_service() {
  [ -f "$ENV_FILE" ] || {
    logger -t "$NAME" "missing $ENV_FILE"
    return 1
  }
  [ -x "$MINIEAP" ] || {
    logger -t "$NAME" "minieap missing"
    return 1
  }

  # optional: refresh conf for manual minieap -w users (ignore failure)
  if [ -x /usr/bin/ruijie-minieap-ctl ]; then
    /usr/bin/ruijie-minieap-ctl render-conf 2>/dev/null || true
  fi

  # shellcheck disable=SC1090
  set -a
  # shellcheck source=/dev/null
  . "$ENV_FILE"
  set +a

  NIC="${RUIJIE_NIC:-wan}"
  MOD="${RUIJIE_MODULE:-rjv3}"
  A="${RUIJIE_EAP_BCAST:-1}"
  # Default 0: keep process for Keep-Alive; OpenWrt handles DHCP
  D="${RUIJIE_DHCP_TYPE:-0}"
  E="${RUIJIE_HEARTBEAT:-60}"
  VER="${RUIJIE_VERSION_STR:-RG-SU For Linux V1.31}"
  SVC="${RUIJIE_SERVICE:-internet}"
  SER="${RUIJIE_FAKE_SERIAL:-OPENWRT-001}"
  USER="${RUIJIE_USERNAME}"
  PASS="${RUIJIE_PASSWORD}"

  procd_open_instance
  # -b 0: foreground under procd (Keep-Alive stays alive)
  # no -c: dhcp-script races with netifd udhcpc
  procd_set_param command "$MINIEAP" -k 1 \
    -u "$USER" -p "$PASS" -n "$NIC" --module "$MOD" \
    -a "$A" -d "$D" -e "$E" \
    --version-str "$VER" \
    --service "$SVC" \
    --fake-serial "$SER" \
    -t 8 --max-retries 3 \
    -b 0
  # slow respawn if crash (avoid tight restart loops)
  procd_set_param respawn 5 30 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param file "$ENV_FILE"
  procd_close_instance

  # delayed soft DHCP renew after auth settles
  (
    sleep 12
    [ -x "$POST_AUTH" ] && "$POST_AUTH"
    sleep 8
    [ -x "$POST_AUTH" ] && "$POST_AUTH"
  ) &

  logger -t "$NAME" "started nic=$NIC module=$MOD a=$A d=$D (soft post-auth, no dhcp-script)"
}

stop_service() {
  # do not call ruijie-minieap-ctl stop (can hang under set -e / PID races)
  "$MINIEAP" -k 2>/dev/null || true
  killall minieap 2>/dev/null || true
  sleep 1
  killall -9 minieap 2>/dev/null || true
  rm -f /var/run/minieap.pid
}

reload_service() {
  stop
  start
}

# Intentionally NO: procd_add_reload_trigger "network"
# WAN DHCP renew must not restart 802.1x.
