#!/bin/sh /etc/rc.common
# OpenWrt procd service: Ruijie campus auth via minieap
# Config: /etc/ruijie/env
#
# Minimal reboot-safe changes vs original:
# - post-auth is soft-only (script itself never ifdown)
# - NO procd network reload trigger (renew must not restart 802.1x)

START=99
STOP=10
USE_PROCD=1

NAME=ruijie-minieap
CTL=/usr/bin/ruijie-minieap-ctl
ENV_FILE=/etc/ruijie/env
MINIEAP=/usr/sbin/minieap
POST_AUTH=/usr/bin/ruijie-post-auth.sh

_wait_wan() {
  [ -f "$ENV_FILE" ] && . "$ENV_FILE" 2>/dev/null || true
  _nic="${RUIJIE_NIC:-wan}"
  _i=0
  while [ "$_i" -lt 45 ]; do
    if [ -d "/sys/class/net/$_nic" ]; then
      st=$(cat "/sys/class/net/$_nic/operstate" 2>/dev/null || echo down)
      car=$(cat "/sys/class/net/$_nic/carrier" 2>/dev/null || echo 0)
      if [ "$st" = "up" ] || [ "$car" = "1" ]; then
        # wait until has any IPv4 (pre-auth OK) or 15s with link
        if ip -4 addr show "$_nic" 2>/dev/null | grep -q "inet "; then
          logger -t "$NAME" "WAN $_nic ready with IPv4 (waited ${_i}s)"
          return 0
        fi
        if [ "$_i" -ge 15 ]; then
          logger -t "$NAME" "WAN $_nic link up, start without IPv4 (waited ${_i}s)"
          return 0
        fi
      fi
    fi
    _i=$((_i + 1))
    sleep 1
  done
  logger -t "$NAME" "WAN $_nic not ready after 45s, start anyway"
  return 0
}

boot() {
  (
    sleep 10
    _wait_wan
    sleep 3
    start
    # soft renew after auth window (do not stop/start again)
    sleep 15
    [ -x "$POST_AUTH" ] && "$POST_AUTH"
    sleep 10
    [ -x "$POST_AUTH" ] && "$POST_AUTH"
  ) &
}

start_service() {
  [ -f "$ENV_FILE" ] || { logger -t "$NAME" "missing $ENV_FILE"; return 1; }
  [ -x "$MINIEAP" ] || { logger -t "$NAME" "minieap missing"; return 1; }

  [ -x "$CTL" ] && "$CTL" render-conf 2>/dev/null || true

  set -a
  . "$ENV_FILE"
  set +a

  NIC="${RUIJIE_NIC:-wan}"
  MOD="${RUIJIE_MODULE:-rjv3}"
  A="${RUIJIE_EAP_BCAST:-1}"
  D="${RUIJIE_DHCP_TYPE:-2}"
  E="${RUIJIE_HEARTBEAT:-60}"
  VER="${RUIJIE_VERSION_STR:-RG-SU For Linux V1.31}"
  SVC="${RUIJIE_SERVICE:-internet}"
  SER="${RUIJIE_FAKE_SERIAL:-OPENWRT-001}"
  USER="${RUIJIE_USERNAME}"
  PASS="${RUIJIE_PASSWORD}"
  DHCP_SCRIPT="${RUIJIE_DHCP_SCRIPT:-/usr/bin/ruijie-post-auth.sh}"

  procd_open_instance
  procd_set_param command "$MINIEAP" -k 1 \
    -u "$USER" -p "$PASS" -n "$NIC" --module "$MOD" \
    -a "$A" -d "$D" -e "$E" \
    --version-str "$VER" \
    --service "$SVC" \
    --fake-serial "$SER" \
    -c "$DHCP_SCRIPT" \
    -t 8 --max-retries 3 \
    -b 0
  procd_set_param respawn 3600 10 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param file "$ENV_FILE"
  procd_close_instance

  (
    sleep 12
    [ -x "$POST_AUTH" ] && "$POST_AUTH"
    sleep 10
    [ -x "$POST_AUTH" ] && "$POST_AUTH"
  ) &

  logger -t "$NAME" "started nic=$NIC a=$A d=$D soft-post-auth"
}

stop_service() {
  "$MINIEAP" -k 2>/dev/null || true
  killall minieap 2>/dev/null || true
  sleep 1
  killall -9 minieap 2>/dev/null || true
  rm -f /var/run/minieap.pid
}

reload_service() {
  stop
  start
}

# NO procd_add_reload_trigger "network"
