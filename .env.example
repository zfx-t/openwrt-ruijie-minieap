# ============================================================
# 本地部署配置（电脑侧）
# ============================================================
# 用法：
#   cp .env.example .env
#   编辑 .env 填入真实信息
#   ./deploy.sh --verify
#
# deploy.sh 会把 RUIJIE_* / MINIEAP_* 推到路由器 /etc/ruijie/env
# ROUTER / SSH_* 仅用于电脑 SSH，不会写进路由器
#
# 注意：.env 已在 .gitignore，请勿提交真实密码
# 含空格的值请用双引号
# ============================================================

# ---------- 路由器 SSH（仅 deploy.sh 使用）----------

# 路由器 LAN 管理地址
ROUTER="192.168.3.1"

# SSH 用户名（OpenWrt 一般为 root）
SSH_USER="root"

# SSH 端口
SSH_PORT="22"

# SSH 密码（可选；已配置公钥时可留空）
# 使用密码时本机需安装 sshpass
# SSH_PASS="password"

# ---------- 校园网账号（必填，会写入路由器 /etc/ruijie/env）----------

# 校园网账号 / 学号 / 工号
RUIJIE_USERNAME="YOUR_STUDENT_ID"

# 校园网密码
RUIJIE_PASSWORD="YOUR_PASSWORD"

# ---------- 网卡 ----------

# 面对校园网的接口名
# 在路由器上查看：ip -br link  或  uci show network.wan
# 常见：wan / eth0.2 / eth1
# 暨南宿舍实测：用 wan，不要用 eth0 整口
RUIJIE_NIC="wan"

# ---------- 锐捷 / minieap 认证参数 ----------

# EAPOL 广播类型（minieap -a）
#   0 = 标准广播
#   1 = 锐捷私有组播（多数学校需要，含暨南；填 0 常找不到认证服务器）
RUIJIE_EAP_BCAST="1"

# DHCP 时机（minieap -d）
#   0 = 不用 DHCP
#   1 = 二次认证
#   2 = 认证后再 DHCP（推荐，对应官方「认证后获取」）
#   3 = 认证前 DHCP
RUIJIE_DHCP_TYPE="2"

# 服务名（minieap --service）
# 学校要求的业务/运营商名，常见 internet；以官方客户端 -s 列表为准
RUIJIE_SERVICE="internet"

# 客户端版本串（minieap --version-str）
# 服务器可能校验；暨南官方 Linux 学生端为 1.31
RUIJIE_VERSION_STR="RG-SU For Linux V1.31"

# 伪造硬盘序列号（minieap --fake-serial）
# 路由器无物理硬盘时填任意稳定字符串
RUIJIE_FAKE_SERIAL="OPENWRT-001"

# 心跳间隔（秒），认证成功后 Keep-Alive 周期
RUIJIE_HEARTBEAT="60"

# minieap 插件：rjv3 = 锐捷 V3（默认）
RUIJIE_MODULE="rjv3"

# ---------- 可选：minieap 离线 ipk ----------

# opkg 无包或 ABI 不兼容时，install.sh 从此 URL 下载
# 需匹配架构与固件年代，例如 mipsel_24kc + 21.02：
# MINIEAP_IPK_URL="https://downloads.immortalwrt.org/releases/21.02.7/packages/mipsel_24kc/packages/minieap_0.93-3_mipsel_24kc.ipk"
# MINIEAP_IPK_URL=""
