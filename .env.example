# Copy to /etc/ruijie/env on the router (chmod 600).
# Or: cp .env.example .env && edit, then ./deploy.sh will push it.

# ---- Required ----
RUIJIE_USERNAME="YOUR_STUDENT_ID"
RUIJIE_PASSWORD="YOUR_PASSWORD"

# ---- Network ----
# WAN interface that faces campus network (OpenWrt: often wan, eth0.2, eth1)
RUIJIE_NIC="wan"

# ---- Ruijie / minieap (JNU-tested defaults) ----
# 1 = Ruijie private EAPOL broadcast (required for many campuses including JNU)
RUIJIE_EAP_BCAST="1"
# dhcp-type: 0 none, 1 dual auth, 2 after auth, 3 before auth
RUIJIE_DHCP_TYPE="2"
RUIJIE_SERVICE="internet"
RUIJIE_VERSION_STR="RG-SU For Linux V1.31"
RUIJIE_FAKE_SERIAL="OPENWRT-001"
RUIJIE_HEARTBEAT="60"
RUIJIE_MODULE="rjv3"

# ---- Optional: minieap package when opkg has no package ----
# ImmortalWrt 21.02 mipsel_24kc example (match your arch / musl age)
# MINIEAP_IPK_URL=https://downloads.immortalwrt.org/releases/21.02.7/packages/mipsel_24kc/packages/minieap_0.93-3_mipsel_24kc.ipk

# ---- Deploy from PC (deploy.sh only) ----
# ROUTER=192.168.3.1
# SSH_USER=root
# SSH_PORT=22
# SSH_PASS=   # optional if using sshpass; prefer SSH keys
